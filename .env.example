# ── Supabase ──────────────────────────────────────────────────
# Painel Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui   # NUNCA exponha no frontend

# ── API-Football ───────────────────────────────────────────────
# Cadastre-se em https://dashboard.api-football.com/register (plano grátis: 100 req/dia)
APIFOOTBALL_KEY=sua_chave_aqui

# ── Segurança do Cron ──────────────────────────────────────────
# Qualquer string aleatória segura — protege o endpoint do cron
# Gere com: openssl rand -base64 32
CRON_SECRET=gere_uma_string_aleatoria_segura_aqui

# ── Football-Data.org ──────────────────────────────────────────
FOOTBALL_DATA_API_KEY=sua_chave_do_football_data_aqui

